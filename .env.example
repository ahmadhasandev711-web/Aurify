# Copy to .env — never commit .env
# Host port of the dev Postgres container. If `docker compose up` says the port is taken or
# forbidden, change it here AND in DATABASE_URL (the two must match).
AURIFY_DB_PORT=54329
DATABASE_URL=postgresql://aurify:aurify@localhost:54329/aurify
LOG_LEVEL=info

# Encrypts Shopify client secrets and access tokens at rest (D-14).
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Better Auth (step 5)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
