# Copy to .env — never commit .env
DATABASE_URL=postgresql://aurify:aurify@localhost:5432/aurify
LOG_LEVEL=info

# Encrypts Shopify client secrets and access tokens at rest (D-14).
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Better Auth (step 5)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
